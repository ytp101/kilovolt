# Never commit .env. Copy this file to .env, then replace both blank secrets
# with different high-entropy values before starting Kilovolt.

# Published multi-architecture image and localhost host port.
KILOVOLT_IMAGE=yodsarun/kilovolt-proxy:v1.3.2
KILOVOLT_HOST_PORT=8080

# Calculated-spend limits in USD. These are estimates, not provider invoices.
KILOVOLT_PROJECT_BUDGET=100.00
KILOVOLT_DEFAULT_BUDGET=5.00

# Replace both with different values, for example from: openssl rand -hex 32
KILOVOLT_PROXY_TOKEN=
KILOVOLT_DASHBOARD_TOKEN=

# The real provider key stays in your application and is sent in each request's
# Authorization header. It is not a Kilovolt environment variable.
KILOVOLT_OPENAI_UPSTREAM_URL=https://api.openai.com/v1/chat/completions

# Safe first-run defaults.
KILOVOLT_TELEMETRY_ENABLED=false
KILOVOLT_ENABLE_MOCK_UPSTREAM=false
KILOVOLT_NON_STREAM_DEFAULT_MAX_OUTPUT_TOKENS=1000

# X-User-ID must be inserted by a trusted authenticated backend. Accounting is
# in memory and resets on restart; use one Kilovolt process per project budget.
# Review built-in model prices before sending real traffic.
