# Intended use: demonstrate incremental streaming enforcement with a deliberately
# small per-user allowance. The client must tolerate a stream ending without
# [DONE] when the next supported output increment would exceed either budget.
BIND_ADDR=127.0.0.1
KILOVOLT_PORT=8080
KILOVOLT_PROJECT_BUDGET=25.00
KILOVOLT_DEFAULT_BUDGET=0.05
KILOVOLT_PROXY_TOKEN=replace-with-a-random-secret
KILOVOLT_DASHBOARD_TOKEN=replace-with-a-different-random-secret
KILOVOLT_TELEMETRY_ENABLED=false
KILOVOLT_ENABLE_MOCK_UPSTREAM=false

# Test locally without a provider by using docker-compose.demo.yml and
# scripts/demo-smoke.sh. Accounting is conservative per supported SSE event,
# process-local, reset on restart, and not provider invoice equivalence.
