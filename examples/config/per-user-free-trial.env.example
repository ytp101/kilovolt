# Intended use: one application project with a $5 calculated-spend allowance for
# every trusted user identity supplied by the authenticated founder backend.
BIND_ADDR=127.0.0.1
KILOVOLT_PORT=8080
KILOVOLT_PROJECT_BUDGET=100.00
KILOVOLT_DEFAULT_BUDGET=5.00
KILOVOLT_PROXY_TOKEN=replace-with-a-random-secret
KILOVOLT_DASHBOARD_TOKEN=replace-with-a-different-random-secret
KILOVOLT_TELEMETRY_ENABLED=false
KILOVOLT_ENABLE_MOCK_UPSTREAM=false

# Test: send a bounded request with X-User-ID, repeat until 429, and confirm spend
# in /api/stats. Never accept X-User-ID directly from an unauthenticated client.
# This is one default for all users; no runtime per-user override API exists.
