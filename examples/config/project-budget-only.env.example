# Intended use: cap one single-process application project without a tighter
# per-user allowance. Because both ledgers are always enforced, keep the default
# per-user limit equal to the project limit.
BIND_ADDR=127.0.0.1
KILOVOLT_PORT=8080
KILOVOLT_PROJECT_BUDGET=25.00
KILOVOLT_DEFAULT_BUDGET=25.00
KILOVOLT_PROXY_TOKEN=replace-with-a-random-secret
KILOVOLT_DASHBOARD_TOKEN=replace-with-a-different-random-secret
KILOVOLT_TELEMETRY_ENABLED=false
KILOVOLT_ENABLE_MOCK_UPSTREAM=false

# Test: start Kilovolt, send bounded requests for two trusted X-User-ID values,
# then inspect /api/stats. Limits are local cost estimates, not provider invoices.
# Spend is in memory, resets on restart, and is unsafe across multiple processes.
